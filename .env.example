# ============================================================================
# AeroTrack Chile - Geospatial ADS-B Telemetry & Tactical Airspace Monitor
# ============================================================================

# --- Server & WebSocket Gateway ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=*

# --- Redis Volatile Cache & Rate Limiting ---
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=aerotrack:
STATE_TTL_SECONDS=120
TRAIL_MAX_POINTS=150

# --- ADS-B Telemetry Ingestion & Quota Strategy ---
# Primary: OpenSky Network REST API (/states/all)
OPENSKY_BASE_URL=https://opensky-network.org/api/states/all
# Optional OpenSky OAuth2 / Basic Auth credentials for higher quota
OPENSKY_USERNAME=
OPENSKY_PASSWORD=

# Secondary Fallback: adsb.fi Open Community API
ADSBFI_BASE_URL=https://opendata.adsb.fi/api/v2

# Polling interval in milliseconds (5000 - 10000ms recommended)
POLLING_INTERVAL_MS=6000
HTTP_TIMEOUT_MS=5000
MAX_HTTP_RETRIES=3

# Synthetic traffic disabled by default (100% real live ADS-B traffic from adsb.fi + OpenSky)
ENABLE_HYBRID_SYNTHETIC_TRAFFIC=false
SYNTHETIC_AIRCRAFT_COUNT=0

# --- Default Chilean Airspace Bounding Box ---
# Covers Continental Chile, Juan Fernandez Archipelago & Rapa Nui (SCEZ/SCFA/SCTE/SCCF/SCIP)
DEFAULT_LAMIN=-56.5
DEFAULT_LOMIN=-109.5
DEFAULT_LAMAX=-17.5
DEFAULT_LOMAX=-66.0

# Spatial Hashing Geohash precision (4 to 6)
SPATIAL_GEOHASH_PRECISION=4

# --- Frontend Configuration (Vite) ---
VITE_WS_URL=ws://localhost:4000/ws
VITE_API_URL=http://localhost:4000/api
VITE_INITIAL_LAT=-33.4489
VITE_INITIAL_LON=-70.6693
VITE_INITIAL_ZOOM=6.0
